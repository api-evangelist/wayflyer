        {
          "id": "0cd22c61-44de-452c-8b63-4bfc463e1a88",
          "name": "Start a hosted application",
          "request": {
            "name": "Start a hosted application",
            "description": {
              "content": "Start a hosted application for the company i.e., one the user will complete on the Wayflyer app.\n\nIf the company hasn't already been onboarded with Wayflyer then a new company is created in the Wayflyer app with a\nfunding application pre-configured using any additional data supplied during the API call. The response contains a\n`next` url to redirect the user to which will typically be a co-branded landing page from which they can create\ntheir user account and complete the funding application.\n\nReturns a `next` url to redirect the company to.\n\n`next` url will default to a help center article if an error occurs starting the company's hosted application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "company",
                "hosted-application",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
