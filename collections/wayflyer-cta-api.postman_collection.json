            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_data\": {\n    \"company_name\": \"<string>\",\n    \"company_currency\": \"<string>\",\n    \"primary_store_url\": \"<string>\",\n    \"company_annual_revenue\": \"<integer>\",\n    \"company_onboarding_date\": \"<date>\",\n    \"company_incorporation_date\": \"<date>\",\n    \"country\": \"<string>\",\n    \"state\": \"<string>\",\n    \"company_type\": \"<string>\"\n  },\n  \"user_data\": {\n    \"first_name\": \"<string>\",\n    \"last_name\": \"<string>\",\n    \"email_address\": \"<string>\",\n    \"phone_number\": \"<string>\"\n  },\n  \"partner_data\": {}\n}",
