{
  "opencollection": "1.0.0",
  "info": {
    "name": "Embedded Finance Auth Data Upload API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "Data Upload",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Initiate file upload",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wayflyer.com/financing/partner/anon-data-upload/file/",
            "headers": [
              {
                "name": "API-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Initiate a file upload of anonymised company data.\n\nUse this endpoint when the amount of data exceeds the size of a single request. Otherwise, use the batch upload\nendpoint.\n\nThis allows sharing of anonymised data about companies ahead of time that Wayflyer can use to provide a better\nexperience by generating indicative offers, pre-screening, etc.\n\nDivide the file into the number of parts specified by `num_parts` in the response. There will be an equal number\nof `upload_urls`. For each file part"
        },
        {
          "info": {
            "name": "Initiate batch upload",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wayflyer.com/financing/partner/anon-data-upload/batch/",
            "headers": [
              {
                "name": "API-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Initiate a batch upload of multiple companys revenue data.\nThe number of companies should not be more than 26.000."
        },
        {
          "info": {
            "name": "Get upload status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wayflyer.com/financing/partner/anon-data-upload/upload/:upload_id/",
            "headers": [
              {
                "name": "API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "upload_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the status of a file as it is being processed asynchronously."
        },
        {
          "info": {
            "name": "Complete file upload",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.wayflyer.com/financing/partner/anon-data-upload/upload/:upload_id/",
            "headers": [
              {
                "name": "API-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "upload_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Once all parts of a file have been uploaded, call this endpoint to complete the upload and begin processing.\n\nThe status of the upload can be tracked using the `upload_id` from the initiate file upload endpoint with\nthe get upload status endpoint."
        }
      ]
    }
  ],
  "bundled": true
}