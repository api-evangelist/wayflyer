{
  "opencollection": "1.0.0",
  "info": {
    "name": "Embedded Finance Auth Simulation API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "Simulation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get hosted application simulation status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wayflyer.com/financing/company/hosted-application/simulation/",
            "headers": [
              {
                "name": "API-Version",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get and return the current simlation status for the customer and the valid actions that can be performed."
        },
        {
          "info": {
            "name": "Perform a simulation action",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wayflyer.com/financing/company/hosted-application/simulation/",
            "headers": [
              {
                "name": "API-Version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Perform a simulation action on company's hosted application.\n\nReturns HTTP 204 No Content on success."
        }
      ]
    }
  ],
  "bundled": true
}